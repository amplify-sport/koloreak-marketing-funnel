# ============================================================================
# CONFIGURATION VARIABLES D'ENVIRONNEMENT - KOLOREAK MARKETING FUNNEL
# ============================================================================
# Dupliquez ce fichier en 'functions/.env' et renseignez vos clés réelles.

# 1. Clé Google Gemini AI (Génération des textes, accroches et hashtags)
GEMINI_API_KEY=AIzaSy...

# 2. Instagram Graph API (Meta for Developers)
# ID du compte professionnel Instagram (ex: 17841400000000000)
INSTAGRAM_ACCOUNT_ID=178414...
# Access Token longue durée (Page Token ou User Token avec permissions instagram_basic, instagram_content_publish)
INSTAGRAM_ACCESS_TOKEN=EAAG...
# Publication directe automatique (true = publie sur Instagram, false = enregistre en brouillon dans Firestore)
AUTO_PUBLISH_INSTAGRAM=true

# 3. Média par défaut pour Instagram (Requis car Instagram exige une URL d'image/vidéo publique valide)
DEFAULT_MEDIA_URL=https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1200&q=80

# 4. Informations Salon Koloreak
PLANITY_URL=https://www.planity.com/koloreak-64100-bayonne
SALON_PHONE=0535395164
SALON_ADDRESS=37 Rue Maubec, 64100 Bayonne

# 5. Notifications par Email (Optionnel - Pour relances clients et alertes)
GMAIL_EMAIL=contact@koloreak.com
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
